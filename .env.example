# Copy to .env and fill in what you have. The site saves emails either way.

# Inbox that should get a note for every new signup (needs RESEND_API_KEY).
NOTIFY_EMAIL=

# Free key from https://resend.com — only needed if you want inbox alerts.
RESEND_API_KEY=

# Optional. Use a sender on a domain you verified in Resend.
# NOTIFY_FROM=Carmella <hello@carmella.app>

# Optional. Zapier, Make, or any URL that accepts a JSON POST.
WEBHOOK_URL=

# Optional. Unlocks a CSV download at /api/waitlist.csv?token=THIS
ADMIN_TOKEN=
